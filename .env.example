# Example environment for the gtfs-dleung Streamlit app.
# Copy to `.env` (gitignored) and edit values. NEVER commit `.env` itself.
#
# Demo credential — the actual demo password is `gtfs-demo-2026`.
# The bcrypt hash below was generated with bcrypt.gensalt(rounds=12).
# Rotation policy: regenerate before each new demo cycle. See docs/SECURITY.md.
GTFS_DEMO_USERNAME=demo
GTFS_DEMO_PASSWORD_BCRYPT=$2b$12$nGiMs9lnemij6sGDk6MNCOGm0ycfLJpBY8keXWIIIuYdc7Fle.xZ6

# MBTA GTFS-RT feed URLs (no API key required for the public feeds).
GTFS_RT_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
GTFS_RT_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
GTFS_RT_SERVICE_ALERTS_URL=https://cdn.mbta.com/realtime/Alerts.pb

# Polite outbound fetch interval — 10s minimum (see docs/SECURITY.md / RFC 9110).
GTFS_RT_FETCH_INTERVAL_SECONDS=10

# Feed-staleness threshold — data older than this is considered stale.
# MBTA publishes ~5s; 30s indicates a real publisher-side problem.
GTFS_STALE_THRESHOLD_S=30

# streamlit-authenticator cookie HMAC key. Rotate alongside the demo password.
# Anyone with this key can forge sessions for the running app.
GTFS_COOKIE_KEY=gtfs-dleung-demo-cookie-key-rotate-me
GTFS_COOKIE_EXPIRY_DAYS=1

# Sliding-window inbound rate limit (per Streamlit session).
GTFS_INBOUND_RATE_LIMIT_REQUESTS=60
GTFS_INBOUND_RATE_LIMIT_WINDOW_SECONDS=60

# Identifying User-Agent for outbound requests (be a good neighbour).
# Format: <app>/<version> (<maintainer name>; <disclosure email>).
GTFS_USER_AGENT=gtfs-dleung/0.0.1 (David Leung; claude.unraveled663@simplelogin.com)
